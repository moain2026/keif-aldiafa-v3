# ============================================================
# keifaldiafa.com — متغيرات البيئة (نسخة مثال)
# انسخ هذا الملف إلى .env.local محلياً، أو أضف القيم في
# Vercel → Settings → Environment Variables للإنتاج.
# ============================================================

# Meta Pixel (Facebook / Instagram)
# احصل عليه من: Meta Business Suite → Events Manager → Data Sources
# رقم مكوّن من 15-16 خانة تقريباً
NEXT_PUBLIC_META_PIXEL_ID=xxxxxxxxxxxxxxxx

# TikTok Pixel
# احصل عليه من: TikTok Ads Manager → Assets → Events → Web Events
# معرّف حروف/أرقام بطول ~20 خانة (مثال: C1234ABCDEFGHIJKLMNO)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXXXX

# ملاحظة: البكسلات لا تُحمَّل إطلاقاً ما لم تُعرَّف هذه المتغيرات.
# GA4 و Google Ads يعملان دائماً (معرّفاتهما ثابتة في الكود).
